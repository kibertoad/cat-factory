# --- Local-mode configuration (copy to .env) --------------------------------------
# Run the whole product on your machine: orchestrator as a Node process, each agent
# job as a local container (Docker/Podman/OrbStack/Colima/Apple `container`), GitHub
# via a PAT, persistence on a local Postgres.
#
# Only the four values in "Required" below must be set — everything after it is optional
# and shown with its default. Two ways to fill them in without hand-editing:
#   pnpm secrets            (in this directory) prints the three crypto secrets
#   npx @cat-factory/cli env  writes a complete, ready-to-run .env (secrets + DATABASE_URL
#                             + a minted VCS PAT) into the current directory
# Every variable both facades share is catalogued in ../../docs/environment-variables.md.

# --- Required ---------------------------------------------------------------------
# Postgres (the docker-compose service). Required.
# Use 127.0.0.1, NOT localhost: on Windows + Docker Desktop `localhost` resolves to IPv6 `::1`
# first, which hits the WSL relay and RESETS the connection — the server then dies at boot with
# `read ECONNRESET` during migrate and never binds the port. 127.0.0.1 forces IPv4 through the
# working docker proxy. (On native Linux/macOS `localhost` is fine, but 127.0.0.1 is safe there too.)
DATABASE_URL=postgres://cat:cat@127.0.0.1:5432/catfactory

# Signs the session JWT (and the short-lived proxy/machine tokens local jobs use). REQUIRED,
# at least 32 characters, and must stay STABLE: a fresh value each boot invalidates your
# session and forces a re-login (the original "re-enter the PAT every restart" bug). Boot
# fails loudly if it's unset. See "Sign-in" below for the surrounding auth knobs.
AUTH_SESSION_SECRET=

# Shared key backing credential encryption at rest (document/task/runner/slack
# integrations, personal subscriptions, observability connections). REQUIRED (base64, 32
# bytes) and must stay stable: a fresh key each boot orphans every credential sealed under
# the previous one, and boot fails loudly if it's unset.
ENCRYPTION_KEY=

# Inbound-auth secret the orchestrator injects into every agent container and sends on each
# harness call (the `x-harness-secret` header), so a job container only answers this service.
# REQUIRED (at least 16 characters) and must stay STABLE across restarts: otherwise polls
# against a container still running from before a restart fail auth and the run flaps instead
# of re-attaching. Boot fails loudly if it's unset.
HARNESS_SHARED_SECRET=

# --- Database (optional) ----------------------------------------------------------
# Postgres schema overrides (optional; for a SHARED database). All default to the values below,
# so a normal local install needs none of them. Set them when this database is shared with other
# services so cat-factory can't collide with a schema another service owns. Each must be a plain
# lowercase identifier ([a-z_][a-z0-9_]*):
#   DB_SCHEMA — the default app tables (relocated via search_path); set when there's no usable `public`.
#   DB_MIGRATIONS_SCHEMA — the drizzle migration ledger; set so it can't collide with another
#     drizzle-using service's default `drizzle.__drizzle_migrations`.
#   DB_PGBOSS_SCHEMA — pg-boss's durable-job queue schema.
# The named app schemas (telemetry / sandbox / provisioning) are fixed and not configurable.
# DB_SCHEMA=public
# DB_MIGRATIONS_SCHEMA=drizzle
# DB_PGBOSS_SCHEMA=pgboss

# --- Source control ---------------------------------------------------------------
# GitHub personal access token used by the agent containers to clone, push branches
# and open PRs. A fine-grained token scoped to the target repo(s) with contents +
# pull-requests write is recommended. Required for repo-operating agent steps. It is ALSO
# how you sign in: when set, the local login screen shows "Sign in with configured GitHub
# PAT" (the PAT's account becomes your signed-in identity) and the token stays here on the
# server, never typed into or shown in the browser.
# LEAVING IT UNSET IS FINE: the sign-in screen then offers to take a token directly, and the
# one you paste becomes this deployment's credential too — sealed under ENCRYPTION_KEY in
# ~/.cat-factory/vcs-credential.sqlite, live immediately, no restart. Setting it HERE wins
# over an installed one and turns that form off, which is what you want on a deployment other
# people can reach over the network.
# OPTIONAL in mothership mode (LOCAL_MOTHERSHIP_URL set): without a PAT, GitHub runs on
# short-lived installation tokens the mothership's GitHub App mints for this node over the
# machine API, and you sign in via the mothership login instead. A set PAT still wins.
GITHUB_PAT=

# GitLab personal access token (optional). When set, the local login screen offers
# "Sign in with configured GitLab PAT" (the token's GitLab account becomes your identity).
# A token with the `api` scope works. For a self-managed instance, set GITLAB_API_BASE
# (e.g. https://gitlab.example.com/api/v4).
# GITLAB_PAT=
# GITLAB_API_BASE=

# --- Service ----------------------------------------------------------------------
# The port the service listens on. PUBLIC_URL defaults to http://<host-alias>:<PORT> so
# job containers can reach the LLM proxy, where <host-alias> depends on the selected
# container runtime (see "Container runtime" below) — host.docker.internal for docker.
PORT=8787

# Browser origins the backend allows cross-origin. NOT needed for the standard local SPA:
# local mode defaults ENVIRONMENT=local, so with CORS_ALLOWED_ORIGINS unset the server
# REFLECTS the requesting origin (auth is a bearer header, credentials mode off). Set this
# only to PIN specific origins — e.g. if you serve the SPA from a non-loopback host and want
# to restrict which origins are accepted. Comma-separated; `*` reflects any origin.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Executor-harness image -------------------------------------------------------
# The executor-harness image run per agent job. OPTIONAL, and normally left UNSET: with no value
# the backend runs the image version this @cat-factory/local-server release was built and tested
# against (RECOMMENDED_HARNESS_IMAGE), pulled and kept current at boot so a rerun never launches a
# stale — or too-new — image. Set it ONLY to lock to a specific version — e.g. reproducing a bug
# on an older image, testing a hotfix on a newer one, or running your own local build (`docker
# build -t cat-factory-executor:local backend/internal/executor-harness`) — accepting that image
# and backend versions are not guaranteed compatible. An override that differs from the matched
# version, or a mutable tag like `:latest`, is warned about at boot (never pin `:latest`).
# LOCAL_HARNESS_IMAGE=cat-factory-executor:local
# Disable the boot-time image refresh (e.g. offline, or you manage the image yourself):
# LOCAL_HARNESS_IMAGE_REFRESH=off

# --- Container runtime (optional) ------------------------------------------------
# Which runtime spins up the per-run agent containers. Defaults to docker. Docker,
# Podman, OrbStack and Colima all speak the Docker CLI; Apple `container` (macOS) has
# its own. Selecting a runtime sets sensible defaults for the binary, the host alias
# the harness uses to reach this service, and whether the Tester's local infra works.
# LOCAL_CONTAINER_RUNTIME=docker        # docker | podman | orbstack | colima | apple
#
# Override the CLI binary explicitly (wins over the runtime's default; e.g. a full path).
# LOCAL_DOCKER_BINARY=docker
# Attach the docker-family containers to a named network.
# LOCAL_DOCKER_NETWORK=
# The hostname the harness uses to reach this service's LLM proxy. Defaults per runtime
# (host.docker.internal for Docker/Podman/OrbStack, host.lima.internal for Colima, the
# vmnet gateway for Apple). If the proxy is unreachable from a job container — common on
# Colima / Apple — set this (or PUBLIC_URL) to your machine's LAN IP.
# LOCAL_HARNESS_HOST_ALIAS=
# Docker-family only: add --add-host=<alias>:host-gateway (needed on Linux Docker;
# harmless on Docker Desktop/OrbStack; OFF by default for Colima/Apple). Explicit wins.
# LOCAL_DOCKER_ADD_HOST_GATEWAY=true
# The Tester ("test environment = local") stands the service's docker-compose infra up
# INSIDE its job container (Docker-in-Docker), which needs a privileged container. Set
# to false if your runtime runs nested containers without it (e.g. rootless Podman).
# Apple `container` cannot do DinD at all: a local-infra Tester run is refused there —
# use the ephemeral test environment (with an environment provider) or a "No infra
# dependencies" service. See README "Container runtimes" + "Running the Tester locally".
# LOCAL_DOCKER_PRIVILEGED_TEST_JOBS=true

# --- Kubernetes test environments: the deploy runner (optional) -------------------
# A "test environment" backed by Kubernetes (local k3s/k3d/kind — configured in the UI under
# Integrations > "Test environments") needs a DEPLOY RUNNER to actually render + apply its
# manifests with kubectl/kustomize/helm. This is SEPARATE from that connection: the connection
# says WHERE to deploy (apiserver, namespace); the deploy runner is WHAT runs the deploy. Without
# it, standing a Kubernetes test environment up fails with "no deploy runner wired". (The
# raw-manifest and "No infra dependencies" environment paths do NOT need it.)
#
# There is NO default MODE: you must pick one explicitly. For `native`, boot FAILS FAST if the mode
# is set without its companion variable — so a half-configured deploy runner surfaces at startup,
# not mid-run. Two modes:
#   container — RECOMMENDED, works out of the box: the deploy-harness IMAGE runs one cold-started
#               container per deploy job on your LOCAL_CONTAINER_RUNTIME. The image is resolved
#               automatically to the version this backend supports (RECOMMENDED_DEPLOY_IMAGE, the
#               same pin the Cloudflare/Node facades use) — just set the line below, no image ref to
#               hunt down. LOCAL_DEPLOY_IMAGE is an ESCAPE HATCH to pin a custom/older build.
#   native    — the deploy harness runs as a HOST PROCESS using your OWN installed kubectl/
#               kustomize/helm against your ambient kubeconfig (no Docker). REQUIRES
#               LOCAL_DEPLOY_HARNESS_ENTRY (the deploy-harness server entry). SECURITY: it runs with
#               your full cluster + file access — fine on your own machine, which is why it is not
#               the silent default.
# Leave LOCAL_DEPLOY_RUNTIME unset (the common case) if you don't stand Kubernetes test envs up.
# LOCAL_DEPLOY_RUNTIME=container
# LOCAL_DEPLOY_HARNESS_ENTRY=          # required when LOCAL_DEPLOY_RUNTIME=native
# LOCAL_DEPLOY_IMAGE=ghcr.io/kibertoad/cat-factory-deploy:<version>   # optional escape hatch (any mode=container)

# --- Warm container pool + checkout reuse -----------------------------------------
# These moved OUT of env into the DB: configure them in the UI under Integrations >
# "Local mode" (warm-pool size / pre-warm / max / idle timeout, and the per-repo
# checkout-reuse workspace root + dep-cache keep list). Off by default (cold-start per
# run). See README "Warm container pool".

# --- Native execution (optional; use your installed Claude Code / Codex) ----------
# Allow-list of subscription harnesses to run as a HOST PROCESS driving your OWN installed
# claude/codex CLI (ambient login) instead of a Docker container — no leased credential.
# Off by default. NO sandbox: the agent runs with your full host access + personal
# subscription. Only a step whose model maps to a listed harness's NATIVE vendor (Anthropic
# claude / OpenAI codex) goes native; GLM/Kimi/DeepSeek (reuse claude-code) and proxy models
# still use the container path (so they still need LOCAL_HARNESS_IMAGE). See README.
# LOCAL_NATIVE_AGENTS=              # e.g. claude-code,codex (empty = off)
# LOCAL_HARNESS_ENTRY=             # OPTIONAL: defaults to the bundled @cat-factory/executor-harness
#                                  # server entry. Only set it to run a custom/source-checkout build.
# The native harness process inherits a SANITIZED environment (PATH, proxy + CA-bundle vars,
# the CLI config homes), never this service's secrets. Add names your tooling needs on top:
# LOCAL_HARNESS_ENV_ALLOW=         # comma-separated, case-insensitive
# Extra `node` arguments for the spawned harness process (e.g. --max-old-space-size=4096):
# LOCAL_HARNESS_NODE_ARGS=
# Inline steps (requirements reviewer / brainstorm / task-estimator) on your subscription:
# by default local + mothership mode run these one-shot text calls on your ambient claude/codex
# CLI, so a preset pinned to claude-opus/GPT starts instead of being refused. This is DECOUPLED
# from LOCAL_NATIVE_AGENTS (container agents stay sandboxed). Set to `off` to disable, or list a
# subset (e.g. claude-code) to restrict which vendors are inline-eligible.
# LOCAL_NATIVE_INLINE=             # default on (claude-code,codex); `off` disables
# How an inline host-CLI run is supervised. The IDLE budget bounds how long the CLI may go
# SILENT (every byte re-arms it), not how long the step may take — a research-heavy inline step
# legitimately runs many minutes across hundreds of stream events, and a single total budget
# killed it for being slow. The ceiling is the backstop for a run that narrates forever. Raise
# the ceiling if a failure says "hit its ...ms ceiling"; raise the idle budget if a healthy run
# on a slow link is killed with "no output".
# Each takes whole milliseconds, 1..2147483647; anything else (`5m`, 0, a fraction, or a value
# above that ceiling) is reported at boot and ignored, because as a timer delay it would fire
# immediately and kill every inline step at once.
# LOCAL_INLINE_CLI_IDLE_TIMEOUT_MS=   # default 300000 (5 min with nothing on either stream)
# LOCAL_INLINE_CLI_MAX_TIMEOUT_MS=    # default 3600000 (1 h of total wall clock)

# --- Model providers --------------------------------------------------------------
# At least one must be configured or the model picker shows nothing selectable (every model
# comes back available:false) and pipelines can't start — EXCEPT for the Claude/Codex models
# a native or inline ambient CLI serves (see "Native execution" above), which need no key.
# Agent containers never hold a provider key themselves — they reach models through this
# service's LLM proxy (/v1) — so the key lives here on the service.
#
# Cloudflare Workers AI over REST. There is NO Workers binding on Node/local, so the
# "workers-ai" models are served over the REST API and need BOTH of these set (this is
# what "Cloudflare AI in local mode" requires; see README "Using Cloudflare AI"):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_GATEWAY=          # optional: route through an AI Gateway slug instead
#
# Or a direct vendor key:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Or a LOCALLY-RUN model (Ollama / LM Studio / llama.cpp / vLLM / a custom
# OpenAI-compatible server): no env var — configure it in the UI under
# Configuration > "My local runners" (per user, stored in the DB, with a "Test
# connection" probe that lists the models your runner serves). Local models need
# no API key — the runner config is sealed with the mandatory ENCRYPTION_KEY. The LLM
# proxy runs in THIS host process, so it reaches e.g. Ollama at localhost:11434
# directly. See README "Using a local model".
#
# Runner-host policy: local mode defaults LOCAL_MODELS_ALLOW_LAN=true so a runner on
# another machine on your LAN works (private 10./172.16-31./192.168. addresses, ULA
# IPv6, mDNS .local names). Set it to false to restrict runners to this machine
# (loopback only), the strict default hosted deployments use.
# LOCAL_MODELS_ALLOW_LAN=true

# --- Web search (self-hosted SearXNG, ON BY DEFAULT) ------------------------------
# Local mode runs a self-hosted SearXNG (the docker-compose `searxng` service) and points
# the backend web-search proxy at it, so agents get web search with zero per-account key
# entry. Agent containers never see the URL — only this host process queries it (over the
# proxy); the URL is a TRUSTED deployment default, so a loopback address is allowed.
#
# Disable it entirely (then the `web_search` tool isn't advertised and you can start just
# Postgres with `pnpm db:up`):
# LOCAL_WEB_SEARCH=off
#
# Override the SearXNG URL (defaults to http://localhost:8080 — the compose-published port):
# WEB_SEARCH_SEARXNG_URL=http://localhost:8080
# WEB_SEARCH_SEARXNG_API_KEY=      # only if you front SearXNG with an auth proxy
# Or use hosted Brave Search instead of SearXNG (its key stays here on the server):
# WEB_SEARCH_BRAVE_API_KEY=

# --- Logging ----------------------------------------------------------------------
# Emit threshold for the structured (pino) logger: debug | info | warn | error.
# LOG_LEVEL=debug is the fastest way to see what a local run is actually doing.
# An unrecognised value falls back to info. See backend/docs/logging.md.
# LOG_LEVEL=info

# --- Tracing & metrics (opt-in) ---------------------------------------------------
# Langfuse trace sink: stream every LLM call — agent containers (via the
# proxy) AND inline calls (requirements review, doc planner, fragment selector) — to
# Langfuse, grouped under each run's trace. Off unless enabled with both keys.
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
#
# OpenTelemetry OTLP/HTTP exporter (traces + metrics) for a Grafana / Honeycomb / OTel
# Collector setup. Needs BOTH the switch and an endpoint; composes alongside Langfuse.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=      # comma-separated key=value pairs (auth headers)
# OTEL_SERVICE_NAME=cat-factory
# Push per-account platform-health aggregates as OTLP gauges (on top of OTEL_ENABLED):
# OTEL_PLATFORM_METRICS=true
# OTEL_PLATFORM_METRICS_WINDOW=1h          # 1h | 24h | 7d
# OTEL_PLATFORM_METRICS_INTERVAL_MS=300000

# --- Platform-health alerting (opt-in) --------------------------------------------
# A periodic sweep over this deployment's OWN run health raises a `platform_health`
# notification (in-app + Slack) when a threshold is crossed, and clears it on recovery.
# PLATFORM_ALERTS=true
# PLATFORM_ALERTS_WINDOW=1h             # aggregation window: 1h | 24h | 7d
# PLATFORM_ALERTS_INTERVAL_MS=300000    # how often the sweep evaluates
# PLATFORM_ALERTS_MIN_RUNS=5            # terminal runs needed before failure-rate can fire
# PLATFORM_ALERTS_MAX_FAILURE_RATE=0.5  # failure rate (0..1) that fires the alert
# PLATFORM_ALERTS_MAX_P99_MINUTES=60    # p99 run duration that fires the slow-run alert
# PLATFORM_ALERTS_MAX_BACKLOG=50        # live run depth that fires the backlog alert
# Per-failure-kind rules, `kind=share[:minCount]`: page when a NAMED cause exceeds the
# share of failures you allow it, far below the dominant-cause ceiling. `minCount` is the
# failures of that kind the window needs first, and a low share is a hair trigger without
# it (five runs with one eviction is already 20%). Unset means no per-kind rules.
# PLATFORM_ALERTS_FAILURE_KIND_RATES=evicted=0.05:3,timeout=0.2

# Slack notifications (opt-in): post board notifications to Slack. Per-account
# connection (bot token encrypted at rest with ENCRYPTION_KEY), per-board routing.
# Connect via the UI — OAuth "Add to Slack" when the app creds are set, else paste a bot
# token. The Slack app OAuth credentials are now configured PER ACCOUNT in the UI (account
# Deployment settings, admin only) and sealed in the DB — no longer via env.
# SLACK_ENABLED=true

# --- Datadog post-release-health (opt-in) -----------------------------------
# Watches the configured observability monitors/SLOs (Datadog today) after a release ships;
# on a regression an on-call agent investigates (a human decides whether to revert). Keys are
# connected in the UI and sealed with ENCRYPTION_KEY. Optional PagerDuty/incident.io
# enrichment posts the investigation onto an incident those systems already opened (annotate,
# not re-alert); those credentials are now configured PER WORKSPACE in the UI, not via env.
# OBSERVABILITY_ENABLED=true

# --- Sign-in (local mode) ---------------------------------------------------------
# Local mode REQUIRES sign-in: anonymous use can't store per-user credentials (personal
# subscriptions, your own API keys), so the SPA shows a login screen. You sign in by (a) a
# configured GITHUB_PAT / GITLAB_PAT (the recommended path — choose once and you stay signed
# in across refreshes AND restarts), (b) a token pasted on the sign-in screen when neither is
# set — it signs you in AND becomes the deployment's source-control credential, or (c) email +
# password. The session is signed with the
# mandatory AUTH_SESSION_SECRET set in "Required" above. The API itself still runs dev-open
# for unauthenticated reads (AUTH_DEV_OPEN=true) — a real session unlocks the per-user
# features. The defaults below are applied automatically; override only to change them.
# AUTH_PASSWORD_ENABLED=true      # email/password sign-in (on by default in local mode)
# AUTH_OPEN_SIGNUP=true           # create a local account with no invite (on by default)
# AUTH_DEV_OPEN=true              # keep the API open for unauthenticated reads
# AUTH_ALLOWED_EMAIL_DOMAINS=     # only relevant if you turn AUTH_OPEN_SIGNUP off
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Enterprise SSO (generic OpenID Connect). Usable locally against a Keycloak/Dex container
# — a loopback issuer may be plain http. NOTE: configuring it REFUSES to boot alongside
# AUTH_DEV_OPEN, which local mode enables by default, so set AUTH_DEV_OPEN=false to try it.
# AUTH_SSO_ISSUER_URL=            # e.g. http://localhost:8080/realms/acme
# AUTH_SSO_CLIENT_ID=
# AUTH_SSO_CLIENT_SECRET=
# Email invitations (available whenever ENCRYPTION_KEY is set; provider key onboarded
# per-account in the UI, sealed under ENCRYPTION_KEY):
# APP_BASE_URL=                   # SPA origin the invite/reset link points at
# System sender for auth emails (password reset). Without it, the reset link is logged
# to the server console — handy for local testing. provider = sendgrid | resend.
# EMAIL_SYSTEM_PROVIDER=resend
# EMAIL_SYSTEM_FROM=no-reply@example.com
# EMAIL_SYSTEM_API_KEY=

# SECURITY: with the gate OPEN the server binds to all interfaces (so on native Linux
# Docker the job containers can reach the LLM proxy via the bridge gateway), meaning
# anyone on your network can reach the API. To lock it down either close the gate
# (AUTH_DEV_OPEN=false) or bind to loopback (HOST=127.0.0.1). Note: HOST=127.0.0.1
# works on Docker Desktop (host.docker.internal still resolves to the host) but NOT on
# native Linux Docker, where the agent containers reach the proxy via the bridge
# gateway IP — keep the default bind there and close the gate instead.
# HOST=127.0.0.1
#
# --- Consensus orchestration (optional) -------------------------------------------
# Enable the multi-model consensus mechanism (specialist panel / debate / ranked
# voting) on eligible steps + the "Enable Consensus" builder toggle. Off ⇒ unchanged.
# CONSENSUS_ENABLED=true

# --- Mothership mode (optional) ---------------------------------------------------
# Point this local node at a hosted cat-factory backend: boards, runs and settings live
# there, while agents keep executing on your machine. Setting the URL is what enables the
# mode; GITHUB_PAT then becomes optional (GitHub runs on installation tokens the
# mothership's App mints for this node). See ../../docs/environment-variables.md.
# LOCAL_MOTHERSHIP_URL=https://cat-factory.example.com
# LOCAL_MOTHERSHIP_TOKEN=          # headless/CI machine-token override (else minted at login)
# Override the paths of the laptop's local node:sqlite stores:
# LOCAL_MOTHERSHIP_TOKEN_DB=
# LOCAL_MOTHERSHIP_CREDENTIAL_DB=
# LOCAL_MOTHERSHIP_SETTINGS_DB=
# LOCAL_MOTHERSHIP_TELEMETRY_DB=
# LOCAL_MOTHERSHIP_WORK_DB=
