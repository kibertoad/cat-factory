// Knip config — unused files / exports / dependencies across the workspace.
// Run AFTER `pnpm build`: workspace packages resolve each other through their exports
// maps into the gitignored dist/, so a cold tree reports a wall of unresolved imports.
//
// The `ignore` / `ignoreDependencies` entries below are the remaining ACCEPTED BASELINE,
// kept explicit so a follow-up can triage them (delete the dead code / drop the dep and
// shrink the list) — they are NOT an invitation to add more. New findings fail CI.
// `exports`/`types`/`duplicates` are reported as non-failing warnings: the bulk (~130
// unused exports/types) has been triaged away (dead code deleted, needless `export`s
// dropped); the residual handful are DELIBERATE re-export barrels (the neutral VcsClient
// port types in `ports/vcs-client.ts`, the Worker `config/index.ts` config-type barrel,
// the `providerEndpoints` base-URL group) plus a couple of types that must stay exported
// for declaration emit even though nothing imports them by name — all intentional, hence
// warn, not error.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
    },
    "backend/packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "backend/packages/contracts": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      // Baseline: not imported from src/ — triage separately.
      "ignoreDependencies": ["@toad-contracts/core"],
    },
    "backend/packages/consensus": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@cat-factory/contracts"],
    },
    "backend/packages/provider-bedrock": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@cat-factory/kernel", "ai"],
    },
    "backend/packages/provider-cloudflare": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@cat-factory/kernel"],
    },
    "backend/packages/server": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@toad-contracts/valibot"],
    },
    "backend/runtimes/*": {
      "entry": ["src/main.ts", "src/link-repo.ts", "src/**/*.test.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts"],
    },
    "backend/runtimes/cloudflare": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts"],
      // The workers-pool vitest config reads ./migrations relative to cwd, which breaks
      // when knip loads it from the repo root — and its test entries are covered by the
      // explicit test/ glob above anyway.
      "vitest": false,
      // `cloudflare` is knip misreading the `cloudflare:workers` module specifier scheme
      // as an npm package. The rest is the accepted unused-dep baseline (plausible
      // leftovers of the @cat-factory/server extraction) — triage separately.
      "ignoreDependencies": [
        "cloudflare",
        "@ai-sdk/openai-compatible",
        "@hono/valibot-validator",
        "pino",
      ],
      // Unreferenced-file baseline (same extraction leftovers) — triage separately.
      "ignore": [
        "src/infrastructure/ai/RunnerJobClient.ts",
        "src/infrastructure/auth/GitHubOAuth.ts",
        "src/infrastructure/auth/middleware.ts",
        "src/infrastructure/auth/signing.ts",
        "src/infrastructure/github/encoding.ts",
        "src/infrastructure/github/state.ts",
        "src/infrastructure/http/params.ts",
        "src/infrastructure/runners/RunnerPoolTransport.ts",
      ],
    },
    "backend/runtimes/node": {
      "entry": ["src/main.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts"],
      // `layered-loader` is loaded via the OPAQUE dynamic import in
      // cacheNotifications.ts (`import('layered-loader' as string)`, gated on
      // REDIS_URL — the cast deliberately hides its Redis modules from the TS
      // build graph), so knip sees no static import.
      "ignoreDependencies": ["layered-loader"],
    },
    "backend/runtimes/local": {
      "entry": ["src/main.ts", "src/link-repo.ts", "src/**/*.test.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts"],
      // `@cat-factory/executor-harness` is resolved dynamically at runtime via
      // createRequire(import.meta.url).resolve('@cat-factory/executor-harness') in
      // LocalProcessRunnerTransport (native mode spawns its bundled dist/server.js), so knip
      // sees no static import.
      "ignoreDependencies": ["@cat-factory/executor-harness"],
    },
    // The public-API SDK client. The smoketest program is an entry point in its own right (the
    // cross-SDK harness runs it), not something `src/index.ts` reaches. The generated modules need
    // no `ignore`: `src/index.ts` re-exports them and is an entry, so their exports are not
    // reported.
    "sdk/typescript": {
      "entry": ["src/index.ts", "test/**/*.test.ts", "smoketest/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "smoketest/**/*.ts"],
    },
    // The MCP facade over that same surface. `src/bin.ts` has to be named explicitly: it is the
    // package's `bin`, but the manifest points at the BUILT `dist/bin.js`, so knip cannot map it
    // back to a source file and the stdio executable would read as an unused file. Same reason
    // the client above lists its smoketest entry by hand.
    "sdk/mcp": {
      "entry": ["src/index.ts", "src/bin.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    // The gatekeeper bindings over that same surface: a generated policy table plus hand-written
    // ladder helpers, re-exported from the entry like the client's generated modules are.
    "sdk/gatekeeper": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "backend/internal/*": {
      "entry": ["src/**/*.ts", "tests/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts"],
    },
    "backend/internal/sdk-smoketest": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts"],
      // The harness SPAWNS the e2e test server rather than importing it — it resolves
      // `@cat-factory/e2e/package.json` to locate `testServer.ts` and runs it as a child process,
      // which is the whole point (the SDKs must be smoketested against a real HTTP deployment, not
      // an in-process app). Knip cannot see a `require.resolve` of a package manifest, so the
      // dependency has to be declared here or it reads as unused.
      "ignoreDependencies": ["@cat-factory/e2e"],
    },
    "backend/internal/benchmark-harness": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@cat-factory/contracts"],
    },
    "backend/internal/smoketest-harness": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@cat-factory/kernel"],
    },
    "backend/internal/executor-harness": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"],
      // Binaries invoked inside the runner container image, not on the dev machine.
      "ignoreBinaries": ["java", "serve", "pi"],
    },
    "frontend/app": {
      "entry": ["app/**/*.{vue,ts}", "i18n/**/*.ts", "scripts/*.mjs"],
      "project": ["app/**/*.{vue,ts}", "i18n/**/*.ts"],
      // @vue-flow/*: referenced as CSS paths in nuxt.config.ts, which knip double-reports
      // as unlisted-in-config + unused-in-app. vue-tsc backs `nuxt typecheck`; msw and
      // @toad-contracts/testing are test-setup deps outside the project globs.
      "ignoreDependencies": [
        "@vue-flow/core",
        "@vue-flow/node-resizer",
        "@toad-contracts/valibot",
        "@toad-contracts/testing",
        "msw",
        "vue-tsc",
      ],
    },
    "deploy/backend": { "entry": ["src/**/*.ts"] },
    "deploy/node": { "entry": ["src/**/*.ts"] },
    "deploy/local": { "entry": ["src/**/*.ts"] },
    // `src/index.ts` is the Worker entry; the specs are the second entry, and the fake origin is
    // read as a SCRIPT STRING by vitest.config.ts rather than imported, so knip cannot see the
    // edge and would report it as an unused file.
    "deploy/gatekeeper": {
      "entry": ["src/index.ts", "test/**/*.ts"],
      "ignore": ["test/fake-cat-factory.mjs"],
    },
    "deploy/frontend": {
      // Backs `nuxt typecheck` in the deploy consumer.
      "ignoreDependencies": ["vue-tsc"],
    },
  },
}
