{
  "name": "@cat-factory/app",
  "version": "0.320.0",
  "description": "Reusable Nuxt layer for the Agent Architecture Board SPA (components, stores, composables, pages). Consume it from a thin deployment app via `extends: ['@cat-factory/app']` and point it at your backend with NUXT_PUBLIC_API_BASE. See deploy/frontend for an example.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/cat-factory.git",
    "directory": "frontend/app"
  },
  "files": [
    "app",
    "!app/stories",
    "!app/**/*.stories.ts",
    "i18n",
    "nuxt.config.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:parity": "node scripts/i18n-locale-parity.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@cat-factory/contracts": "workspace:*",
    "@modular-frontend/core": "0.6.0",
    "@modular-vue/core": "^1.5.0",
    "@modular-vue/journeys": "^1.4.0",
    "@modular-vue/nuxt": "^0.4.1",
    "@modular-vue/runtime": "^1.4.1",
    "@modular-vue/vue": "^1.4.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@toad-contracts/core": "1.0.0",
    "@toad-contracts/frontend-http-client": "1.0.1",
    "@toad-contracts/valibot": "1.0.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-resizer": "^1.5.1",
    "@vueuse/core": "^15.0.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "valibot": "^1.5.0",
    "vue": "3.5.44",
    "wretch": "^3.0.9"
  },
  "devDependencies": {
    "@storybook/vue3": "10.6.2",
    "@toad-contracts/testing": "1.0.0",
    "happy-dom": "^21.0.3",
    "msw": "^3.0.3",
    "nuxt": "^4.6.1",
    "storybook": "10.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "nuxt": "^4.5.2 <4.6.0 || ^4.6.1"
  }
}
