{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {},
  "rules": { "max-lines-per-function": ["error", { "max": 250 }] },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "backend/internal/conformance/src/**",
        "backend/internal/e2e/**"
      ],
      "rules": { "max-lines-per-function": ["error", { "max": 400 }] }
    }
  ],
  "ignorePatterns": ["**/*.generated.ts"],
  "env": { "builtin": true }
}
