{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "test/**/*.ts"],
  "include": ["src/**/*.ts"],
  // `tsc -b` orders the solution build by these, so the verifier is emitted before this imports it.
  "references": [{ "path": "../webhooks/tsconfig.build.json" }]
}
