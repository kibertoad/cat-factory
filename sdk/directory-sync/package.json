{
  "name": "@cat-factory/directory-sync",
  "version": "0.2.2",
  "description": "Keep a copy of a cat-factory account's directory (workspaces, users, memberships, linked repositories) in sync: snapshot bootstrap, change-feed catch-up, signed webhook pushes and periodic reconciliation, over a storage adapter you implement.",
  "keywords": [
    "cat-factory",
    "directory",
    "sync",
    "webhooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/cat-factory.git",
    "directory": "sdk/directory-sync"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@cat-factory/webhooks": "workspace:^"
  },
  "devDependencies": {
    "@cat-factory/sdk": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@cat-factory/sdk": "workspace:>=0.57.0 <1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
