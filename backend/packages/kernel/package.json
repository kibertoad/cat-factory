{
  "name": "@cat-factory/kernel",
  "version": "0.322.1",
  "description": "Shared vocabulary, pure logic, and port interfaces for the Agent Architecture Board.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/cat-factory.git",
    "directory": "backend/packages/kernel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@cat-factory/contracts": "workspace:*",
    "ai": "^7.0.83",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
