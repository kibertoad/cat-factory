+// PATCH: Nuxt >= 4.6 keeps the client-side app context in `globalThis.__nuxt_app_ctx__`
+// (dist/app/internal/context.js), not in the `unctx` registry this preset writes to, so
+// `useNuxtApp()` inside applyPlugins found nothing and every story died with NUXT_E1001.
+// Write into whichever registry the installed Nuxt actually reads.
+function makeClientCtx() {
+  let instance
+  return {
+    use: () => { if (instance === undefined) throw new Error('Context is not available'); return instance },
+    tryUse: () => instance ?? null,
+    set: (v) => { instance = v },
+    unset: () => { instance = undefined },
+    call: (v, cb) => { instance = v; return cb() },
+    callAsync: (v, cb) => { instance = v; return Promise.resolve(cb()) },
+  }
+}
+function getNuxtCtx(key) {
+  const clientContexts = (globalThis.__nuxt_app_ctx__ ||= {})
+  return (clientContexts[key] ||= makeClientCtx())
+}
